rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid));
    }

    function isAdmin() {
      return isSignedIn()
        && userDoc(request.auth.uid).data.admin == true;
    }

    function isNotBanned() {
      return isSignedIn()
        && userDoc(request.auth.uid).data.banido != true;
    }

    function isString(v) {
      return v is string;
    }

    function isNumber(v) {
      return v is int || v is float;
    }

    function unchanged(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == resource.data[field];
    }

    function privilegedFieldsUnchanged() {
      return unchanged('admin')
        && unchanged('banido')
        && unchanged('fundador')
        && unchanged('cargo')
        && unchanged('vipPagoAtivo')
        && unchanged('vipPagoTipo')
        && unchanged('vipPagoCompradoEm')
        && unchanged('patrocinador')
        && unchanged('criador');
    }

    function likesRecebidosChangeAllowed() {
      if (unchanged('likesRecebidos')) {
        return true;
      }

      let oldLikes = resource.data.keys().hasAny(['likesRecebidos'])
        ? resource.data.likesRecebidos
        : 0;

      let newLikes = request.resource.data.keys().hasAny(['likesRecebidos'])
        ? request.resource.data.likesRecebidos
        : 0;

      return resource.data.vipPagoAtivo == true
        && newLikes is int
        && newLikes >= oldLikes
        && newLikes <= oldLikes + 500;
    }

    function badgesChangeAllowed() {
      let oldBadges = resource.data.keys().hasAny(['badges'])
        && resource.data.badges is list
        ? resource.data.badges
        : [];

      let newBadges = request.resource.data.keys().hasAny(['badges'])
        && request.resource.data.badges is list
        ? request.resource.data.badges
        : [];

      let added = newBadges.toSet().difference(oldBadges.toSet());
      let removed = oldBadges.toSet().difference(newBadges.toSet());

      if (added.hasAny(['fundador', 'socio', 'vip_black', 'vip_ouro'])) {
        return false;
      }

      if (added.hasAny(['vip_perola_negra'])) {
        return resource.data.vipPagoAtivo == true
          && added.size() <= 1;
      }

      if (added.hasAny(['vip'])) {
        return request.resource.data.vipAtivo == true;
      }

      return added.size() <= 2
        && removed.size() <= 2;
    }

    function vipFieldsChangeAllowed() {
      if (
        unchanged('vipAtivo')
        && unchanged('vipFim')
        && unchanged('vipTipo')
        && unchanged('vipCompradoEm')
        && unchanged('vipBonusMultiplicador')
        && unchanged('skinVipAtiva')
      ) {
        return true;
      }

      let oldCoins = resource.data.keys().hasAny(['totalCoins'])
        ? resource.data.totalCoins
        : 0;

      let newCoins = request.resource.data.keys().hasAny(['totalCoins'])
        ? request.resource.data.totalCoins
        : 0;

      if (
        resource.data.vipAtivo == true
        && request.resource.data.vipAtivo == false
      ) {
        return true;
      }

      if (
        request.resource.data.vipAtivo == true
        && newCoins is int
        && newCoins <= oldCoins - 14000
      ) {
        return true;
      }

      return false;
    }

    function pontosChangeAllowed() {
      let oldPontos = resource.data.keys().hasAny(['pontos'])
        ? resource.data.pontos
        : 0;

      let newPontos = request.resource.data.keys().hasAny(['pontos'])
        ? request.resource.data.pontos
        : 0;

      return newPontos is int
        && newPontos >= oldPontos
        && newPontos <= oldPontos + 200;
    }

    function coinsChangeAllowed() {
      let oldCoins = resource.data.keys().hasAny(['totalCoins'])
        ? resource.data.totalCoins
        : 0;

      let newCoins = request.resource.data.keys().hasAny(['totalCoins'])
        ? request.resource.data.totalCoins
        : 0;

      return newCoins is int
        && newCoins >= 0
        && newCoins <= oldCoins + 2000
        && newCoins >= oldCoins - 16000;
    }

    function validUserCreate(userId) {
      let data = request.resource.data;

      return data.uid == userId
        && data.admin == false
        && data.banido == false
        && (!('fundador' in data) || data.fundador == false)
        && (!('pontos' in data) || (data.pontos is int && data.pontos >= 0 && data.pontos <= 0))
        && (!('likesRecebidos' in data) || (data.likesRecebidos is int && data.likesRecebidos == 0))
        && (!('totalCoins' in data) || (data.totalCoins is int && data.totalCoins >= 0 && data.totalCoins <= 0))
        && (!('vipAtivo' in data) || data.vipAtivo == false)
        && (!('vipPagoAtivo' in data) || data.vipPagoAtivo == false);
    }

    function validProfileFields() {
      let data = request.resource.data;

      return (!('nome' in data) || (isString(data.nome) && data.nome.size() <= 80))
        && (!('bio' in data) || (isString(data.bio) && data.bio.size() <= 300))
        && (!('foto' in data) || (isString(data.foto) && data.foto.size() <= 500000))
        && (!('instagram' in data) || (isString(data.instagram) && data.instagram.size() <= 500))
        && (!('github' in data) || (isString(data.github) && data.github.size() <= 500))
        && (!('videoPerfil' in data) || (isString(data.videoPerfil) && data.videoPerfil.size() <= 500));
    }

    function validUserSelfUpdate() {
      return privilegedFieldsUnchanged()
        && validProfileFields()
        && pontosChangeAllowed()
        && coinsChangeAllowed()
        && badgesChangeAllowed()
        && vipFieldsChangeAllowed()
        && likesRecebidosChangeAllowed();
    }

    function validLikeCreate(userId, likeId) {
      let data = request.resource.data;
      let expectedId = request.auth.uid + '_' + data.data;

      return isSignedIn()
        && request.auth.uid != userId
        && data.deUid == request.auth.uid
        && data.paraUid == userId
        && isString(data.data)
        && data.data.size() == 10
        && likeId == expectedId;
    }

    // ─── Coleção usuarios ──────────────────────────────────────

    match /usuarios/{userId} {

      // Perfil público individual
      allow get: if true;

      // Ranking público
      allow list: if true;

      allow create: if isOwner(userId)
        && validUserCreate(userId);

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && isNotBanned()
          && validUserSelfUpdate()
        );

      allow delete: if isAdmin();

      // Likes diários
      match /likesDiarios/{likeId} {
        allow read: if isSignedIn();

        allow create: if isNotBanned()
          && validLikeCreate(userId, likeId);

        allow update, delete: if false;
      }
    }

    // ─── Updates ───────────────────────────────────────────────

    match /updates/{updateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }


    // ─── ZYRO PODEPA ───────────────────────────────────────────

    match /zyroPodepaMensagens/{messageId} {
      allow read: if isSignedIn() && isNotBanned();
      allow create: if isSignedIn() && isNotBanned()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid','nome','foto','texto','imageUrl','tipo','createdAt'
        ])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 2000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2000
        && request.resource.data.tipo in ['texto','imagem','texto_imagem'];
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /zyroPodepaConversas/{conversationId} {
      allow read: if isSignedIn() && isNotBanned()
        && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn() && isNotBanned()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participantNames is map
        && request.resource.data.participantPhotos is map;

      allow update: if isSignedIn() && isNotBanned()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if isAdmin();

      match /mensagens/{messageId} {
        allow read: if isSignedIn() && isNotBanned()
          && request.auth.uid in get(
            /databases/$(database)/documents/zyroPodepaConversas/$(conversationId)
          ).data.participants;

        allow create: if isSignedIn() && isNotBanned()
          && request.auth.uid in get(
            /databases/$(database)/documents/zyroPodepaConversas/$(conversationId)
          ).data.participants
          && request.resource.data.keys().hasOnly(['uid','conversationId','texto','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.conversationId == conversationId
          && request.resource.data.texto is string
          && request.resource.data.texto.size() <= 2000;

        allow update: if isAdmin();
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // ─── Amizades e chat privado ZyroDev ───────────────────────

    match /amizades/{amizadeId} {
      allow read: if isSignedIn() && isNotBanned()
        && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn() && isNotBanned()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participantNames is map
        && request.resource.data.participantPhotos is map;

      allow update: if isSignedIn() && isNotBanned()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 120;

      allow delete: if isAdmin();

      match /mensagens/{messageId} {
        allow read: if isSignedIn() && isNotBanned()
          && request.auth.uid in get(
            /databases/$(database)/documents/amizades/$(amizadeId)
          ).data.participants;

        allow create: if isSignedIn() && isNotBanned()
          && request.auth.uid in get(
            /databases/$(database)/documents/amizades/$(amizadeId)
          ).data.participants
          && request.resource.data.keys().hasOnly(['uid','conversationId','texto','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.conversationId == amizadeId
          && request.resource.data.texto is string
          && request.resource.data.texto.size() <= 2000;

        allow update: if isAdmin();
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // ─── Bloqueio padrão ──────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}