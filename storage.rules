rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---- ZYRO PODEPA: imagens do chat (até 20 MB) ----
    match /zyroPodepa/{uid}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size <= 20 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null
                    && (request.auth.uid == uid
                        || firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.admin == true);
    }

    // >>> MANTENHA aqui as regras que você já tinha para fotos, banners, loja etc. <<<
  }
}
